#!/usr/bin/env python3
"""omarchy-mouse-odometer — how far your mouse actually travels.

Reads relative motion straight off the kernel's evdev devices, which is the
raw stream *before* libinput's pointer acceleration. That means the distance
here is desk centimetres your hand really moved, not screen pixels the cursor
jumped: 400 counts at 1000 DPI is 1 cm of desk, whatever the cursor did.

Membership in the `input` group is enough to read the devices; no root.

  omarchy-mouse-odometer run          # the tracker (systemd --user runs this)
  omarchy-mouse-odometer status       # today / week / all-time summary
  omarchy-mouse-odometer devices      # which pointers are being watched
  omarchy-mouse-odometer calibrate    # measure your mouse's real DPI
  omarchy-mouse-odometer set-dpi 1600 # record it
  omarchy-mouse-odometer reset --today
"""

import argparse
import statistics
import collections
import datetime as dt
import errno
import fcntl
import json
import math
import os
import select
import signal
import struct
import sys
import time

# struct input_event { struct timeval time; __u16 type, code; __s32 value; }
EVENT = struct.Struct("llHHi")
EV_KEY, EV_REL, EV_ABS = 0x01, 0x02, 0x03
EV_SYN, SYN_REPORT = 0x00, 0x00
REL_X, REL_Y, REL_HWHEEL, REL_WHEEL = 0x00, 0x01, 0x06, 0x08
ABS_X, ABS_Y = 0x00, 0x01
ABS_MT_SLOT, ABS_MT_POSITION_X = 0x2f, 0x35
ABS_MT_POSITION_Y, ABS_MT_TRACKING_ID = 0x36, 0x39
BTN_FIRST, BTN_LAST = 0x110, 0x117  # BTN_LEFT .. BTN_TASK
BTN_TOUCH = 0x14a
INPUT_PROP_POINTER = 0   # drives a cursor somewhere else: a pad, not a screen
INPUT_PROP_DIRECT = 1    # the finger is on the picture: a touchscreen, not a pad
INPUT_PROP_BUTTONPAD = 2

# EVIOCGABS(axis) is _IOR('E', 0x40 + axis, struct input_absinfo), and the
# struct is six int32s: value, minimum, maximum, fuzz, flat, resolution.
ABSINFO = struct.Struct("6i")

INCH_M = 0.0254
MM_INCH = 25.4
DEFAULT_DPI = 1000
RESCAN_SECONDS = 5.0     # catch a mouse being plugged in or waking up
FLUSH_SECONDS = 15.0     # how often a dirty state file is written
KEEP_DAYS = 400
DPI_SOURCE_LABEL = {
    "calibrated": "measured here",
    "hardware": "read from the mouse",
    "hwdb": "from udev's mouse database",
    "touchpad": "the pad's own scale",
    "default": "assumed \u2014 not calibrated",
}
# Two fingers travelling together is a scroll, and a pad reports no wheel of
# its own. Ten millimetres is roughly what one detent moves a page, so it is
# the fairest way to put a gesture and a wheel in the same column.
SCROLL_TICK_MM = 10.0
AXIS_TOLERANCE = 0.03
# No mouse made runs below this or above this. A reading outside the range is
# not a slow sensor, it is a drag that never happened at the stated distance —
# most often the second Enter arriving before the hand moved.
MIN_PLAUSIBLE_DPI = 200
MAX_PLAUSIBLE_DPI = 30000    # below this, X and Y are one sensor and one number
UNIT_NAME = "omarchy-mouse-odometer.service"
HOURLY_KEEP_DAYS = 7     # hour-by-hour detail is a recent-history luxury
SPARK_BLOCKS = "\u2581\u2582\u2583\u2584\u2585\u2586\u2587\u2588"
STATE_VERSION = 1

HOME = os.path.expanduser("~")
STATE_DIR = os.environ.get("OMARCHY_MOUSE_ODOMETER_STATE") or os.path.join(
    os.environ.get("XDG_STATE_HOME") or os.path.join(HOME, ".local", "state"),
    "omarchy-mouse-odometer")
STATE_PATH = os.path.join(STATE_DIR, "state.json")
CONFIG_PATH = os.path.join(
    os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config"),
    "omarchy-mouse-odometer", "config.json")


# ---------------------------------------------------------------- discovery

Pointer = collections.namedtuple("Pointer", "name path kind has_mt phys")


def low_bits(line):
    """The low 64 bits of a /proc bitmask.

    Multi-word masks print most-significant word first, so every bit this file
    cares about — REL_X through ABS_MT_TRACKING_ID — lives in the last word.
    """
    words = line.split("=", 1)[1].split()
    return int(words[-1], 16) if words else 0


def pointer_devices():
    """Every device that measures a hand moving: mice, trackballs, trackpoints
    and touchpads.

    A mouse says how far it moved; a touchpad says where the finger is. They
    are different transducers for the same physical act, so both are tracked,
    and the difference is confined to `Tracker.settle` — which turns a position
    into the delta a mouse would have reported, before anything downstream can
    tell them apart.

    Keyboards with a scroll wheel report REL too, so both axes are required.
    Touchscreens and tablets report ABS but set INPUT_PROP_DIRECT, and a finger
    on a picture is not a hand crossing a desk, so they are left out.
    """
    found = []
    try:
        with open("/proc/bus/input/devices") as handle:
            blob = handle.read()
    except OSError:
        return found

    for block in blob.split("\n\n"):
        name, handlers, rel, absolute, props, phys = "", [], 0, 0, 0, ""
        for line in block.splitlines():
            if line.startswith("N: Name="):
                name = line.split("=", 1)[1].strip().strip('"').strip()
            elif line.startswith("P: Phys="):
                phys = line.split("=", 1)[1].strip()
            elif line.startswith("H: Handlers="):
                handlers = line.split("=", 1)[1].split()
            elif line.startswith("B: REL="):
                rel = low_bits(line)
            elif line.startswith("B: ABS="):
                absolute = low_bits(line)
            elif line.startswith("B: PROP="):
                props = low_bits(line)

        if rel & 0b11 == 0b11:
            kind, has_mt = "rel", False
        elif (absolute & 0b11 == 0b11
              and not props & (1 << INPUT_PROP_DIRECT)
              and (absolute & (1 << ABS_MT_TRACKING_ID)
                   or props & ((1 << INPUT_PROP_POINTER) | (1 << INPUT_PROP_BUTTONPAD)))):
            # Absolute *and* pad-shaped. The extra test is what keeps a device
            # that merely happens to carry an ABS collection — some mice and
            # remotes do — from being read as a touchpad and counted twice.
            kind, has_mt = "abs", bool(absolute & (1 << ABS_MT_TRACKING_ID))
        else:
            continue

        for handler in handlers:
            if handler.startswith("event"):
                found.append(Pointer(name or handler, "/dev/input/" + handler,
                                     kind, has_mt, phys))
                break

    # A Windows Precision Touchpad exposes two nodes on one Phys: the pad, and
    # a relative "Mouse" collection kept for firmware that predates it. In
    # precision mode — which is every Linux machine — that second node is
    # silent, so watching it means watching nothing and reporting a mouse
    # nobody owns. The pad speaks for the hardware; the compat node yields.
    pads = set(p.phys for p in found if p.kind == "abs" and p.phys)
    return [p for p in found if not (p.kind == "rel" and p.phys in pads)]


def abs_scale(path):
    """A touchpad's own scale, in counts per inch, straight from the kernel.

    Touchpads report `resolution` in units per millimetre because the hardware
    knows how big its own glass is. That makes a pad the one pointer on the
    system that needs no calibration and no guess — the figure is a fact about
    the device, not a setting. None when the pad declines to say.
    """
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
    except OSError:
        return None
    try:
        scale = []
        for axis in (ABS_X, ABS_Y):
            buffer = bytearray(ABSINFO.size)
            request = (2 << 30) | (ABSINFO.size << 16) | (ord("E") << 8) | (0x40 + axis)
            fcntl.ioctl(fd, request, buffer)
            resolution = ABSINFO.unpack(bytes(buffer))[5]
            if resolution <= 0:
                return None
            scale.append(resolution * MM_INCH)
        return tuple(scale)
    except OSError:
        return None
    finally:
        os.close(fd)


class Device:
    """One open evdev node, with the deltas of the report being assembled."""

    def __init__(self, name, path, fd, dpi, source="default", kind="rel", has_mt=False):
        self.name = name
        self.path = path
        self.fd = fd
        self.source = source
        self.dpi_x, self.dpi_y = dpi if isinstance(dpi, tuple) else (dpi, dpi)
        self.dx = 0
        self.dy = 0

        # Absolute pads only. `contacts` is slot -> [x, y, tracking id];
        # `anchor` is where the primary finger sat at the last report, which is
        # what a position has to be subtracted from to become a movement.
        self.kind = kind
        self.has_mt = has_mt
        self.slot = 0
        self.contacts = {}
        self.anchor = None
        self.touches = 0
        # A detent's worth of gesture, in the pad's own integer units. Counting
        # in units rather than millimetres keeps the arithmetic exact: a scroll
        # of precisely two detents must not come out as one because the
        # conversion landed a fraction of a micron short.
        self.scroll_units = 0
        self.scroll_tick = max(1, int(round(SCROLL_TICK_MM * self.dpi_y / MM_INCH)))

    @property
    def dpi(self):
        """The headline number, for logs and for the symmetric common case."""
        return self.dpi_x if self.dpi_x == self.dpi_y else (self.dpi_x + self.dpi_y) / 2


# ------------------------------------------------------------ config/state

def load_json(path, fallback):
    try:
        with open(path) as handle:
            value = json.load(handle)
        return value if isinstance(value, dict) else dict(fallback)
    except (OSError, ValueError):
        return dict(fallback)


def load_config():
    config = load_json(CONFIG_PATH, {})
    # No `dpi` default on purpose: absence means "work it out yourself", which
    # is what lets a fresh install detect rather than assume.
    config.setdefault("devices", {})
    config.setdefault("units", "metric")
    return config


def save_config(config):
    os.makedirs(os.path.dirname(CONFIG_PATH), exist_ok=True)
    write_atomic(CONFIG_PATH, json.dumps(config, indent=2) + "\n")


def as_axes(value, fallback):
    """A DPI setting is either one number or {"x": n, "y": n}.

    Most mice have one square-resolution sensor, so a scalar is the common
    case; gaming mice that expose independent axes get the pair.
    """
    if isinstance(value, dict):
        try:
            return (max(1.0, float(value.get("x", fallback))),
                    max(1.0, float(value.get("y", fallback))))
        except (TypeError, ValueError):
            return (fallback, fallback)
    try:
        single = max(1.0, float(value))
        return (single, single)
    except (TypeError, ValueError):
        return (fallback, fallback)


def parse_hwdb_dpi(blob):
    """Pull MOUSE_DPI out of udev properties.

    udev's hwdb ships a factory DPI for a few hundred known mice. The value is
    either a single `1000@125` or a list with the active one starred:
    `400@125 *1000@125 3200@125`.
    """
    for line in (blob or "").splitlines():
        if not line.startswith("MOUSE_DPI="):
            continue
        entries = line.split("=", 1)[1].split()
        if not entries:
            return None
        chosen = next((e for e in entries if e.startswith("*")), entries[0])
        try:
            return max(1.0, float(chosen.lstrip("*").split("@")[0]))
        except (TypeError, ValueError):
            return None
    return None


def parse_ratbag_dpi(blob):
    """Pull the resolution out of `ratbagctl <device> dpi get` output.

    Wording has moved around between libratbag releases, so this only insists
    on a number attached to "dpi" rather than on any particular sentence.
    """
    import re
    matches = re.findall(r"(\d{3,5})\s*dpi", blob or "", re.IGNORECASE)
    if not matches:
        return None
    return max(1.0, float(matches[0]))


def hwdb_dpi(path):
    return parse_hwdb_dpi(os.popen(
        "udevadm info --query=property --name=%s 2>/dev/null" % shell_quote(path)).read())


def ratbag_dpi(name):
    """libratbag knows the *live* setting, so it survives a DPI button press."""
    if os.system("command -v ratbagctl >/dev/null 2>&1") != 0:
        return None
    try:
        for line in os.popen("ratbagctl list 2>/dev/null").read().splitlines():
            handle, _, label = line.partition(":")
            if not handle.strip() or label.strip().lower() not in name.lower():
                continue
            return parse_ratbag_dpi(os.popen(
                "ratbagctl %s dpi get 2>/dev/null" % shell_quote(handle.strip())).read())
    except OSError:
        return None
    return None


def configured_dpi(config, name):
    """Whatever the user pinned, by device first and then globally."""
    for pattern, value in (config.get("devices") or {}).items():
        if pattern.strip().lower() in name.lower():
            return as_axes(value, float(DEFAULT_DPI))
    if config.get("dpi") is not None:
        return as_axes(config["dpi"], float(DEFAULT_DPI))
    return None


def dpi_for(config, name, path=None, kind="rel"):
    """Resolve a device's DPI and say where the number came from.

    Order matters: a calibration the user measured beats the hardware's own
    claim, which beats a factory figure from udev, which beats a guess. A
    touchpad's scale sits just under the calibration, because it is measured
    too — at the factory, by the people who cut the glass — and none of the
    mouse-shaped sources below know the first thing about it.
    """
    pinned = configured_dpi(config, name)
    if pinned:
        return pinned, "calibrated"

    if kind == "abs" and path:
        glass = abs_scale(path)
        if glass:
            return glass, "touchpad"

    live = ratbag_dpi(name)
    if live:
        return (live, live), "hardware"

    if path:
        factory = hwdb_dpi(path)
        if factory:
            return (factory, factory), "hwdb"

    return (float(DEFAULT_DPI), float(DEFAULT_DPI)), "default"


def blank_bucket():
    return {"meters": 0.0, "counts": 0.0, "clicks": 0, "scrolls": 0,
            "active_seconds": 0, "desk_hours": 0}


def load_state():
    state = load_json(STATE_PATH, {})
    state.setdefault("version", STATE_VERSION)
    state.setdefault("since", dt.date.today().isoformat())
    state.setdefault("total", blank_bucket())
    state.setdefault("days", {})
    state.setdefault("devices", {})
    for key in blank_bucket():
        state["total"].setdefault(key, 0)
    return state


def write_atomic(path, text):
    tmp = path + ".tmp"
    with open(tmp, "w") as handle:
        handle.write(text)
        handle.flush()
        os.fsync(handle.fileno())
    os.replace(tmp, path)


def save_state(state):
    state["updated"] = dt.datetime.now().replace(microsecond=0).isoformat()

    days = state.get("days") or {}
    if len(days) > KEEP_DAYS:
        for stale in sorted(days)[:-KEEP_DAYS]:
            days.pop(stale, None)

    def rounded(bucket):
        out = dict(bucket)
        out["meters"] = round(float(out.get("meters", 0.0)), 3)
        out["counts"] = round(float(out.get("counts", 0.0)), 1)
        if "hours" in out:
            out["hours"] = {hour: round(float(value), 3) for hour, value in out["hours"].items()}
        return out

    recent = set(sorted(days)[-HOURLY_KEEP_DAYS:])
    for day, bucket in days.items():
        if day not in recent:
            bucket.pop("hours", None)

    payload = dict(state)
    payload["total"] = rounded(state["total"])
    payload["days"] = {day: rounded(bucket) for day, bucket in sorted(days.items())}
    payload["devices"] = {name: rounded(bucket) for name, bucket in (state.get("devices") or {}).items()}

    os.makedirs(STATE_DIR, exist_ok=True)
    write_atomic(STATE_PATH, json.dumps(payload, separators=(",", ":")) + "\n")


# ------------------------------------------------------------------ format

def format_metric(meters):
    if meters >= 1000:
        return "%.2f km" % (meters / 1000.0)
    if meters >= 1:
        return "%.0f m" % meters
    return "%.0f cm" % (meters * 100)


def format_imperial(meters):
    feet = meters / 0.3048
    if feet >= 5280:
        return "%.2f mi" % (feet / 5280.0)
    if feet >= 1:
        return "%.0f ft" % feet
    return "%.0f in" % (meters / INCH_M)


def format_distance(meters, units):
    return format_imperial(meters) if units == "imperial" else format_metric(meters)


def format_duration(seconds):
    seconds = int(seconds)
    if seconds >= 3600:
        return "%dh %02dm" % (seconds // 3600, (seconds % 3600) // 60)
    if seconds >= 60:
        return "%dm" % (seconds // 60)
    return "%ds" % seconds


# ------------------------------------------------------------------ daemon

def next_midnight(timestamp):
    tomorrow = dt.date.fromtimestamp(timestamp) + dt.timedelta(days=1)
    return time.mktime((tomorrow.year, tomorrow.month, tomorrow.day, 0, 0, 0, 0, 0, -1))


class Tracker:
    def __init__(self, config, state):
        self.config = config
        self.state = state
        self.devices = {}
        self.dirty = False
        self.last_active_second = 0
        now = time.time()
        self.day = dt.date.fromtimestamp(now).isoformat()
        self.day_ends = next_midnight(now)
        self.hour = ""
        self.hour_starts = 0.0
        self.hour_ends = 0.0

    # -- buckets

    def bucket(self, timestamp):
        if timestamp >= self.day_ends:
            self.day = dt.date.fromtimestamp(timestamp).isoformat()
            self.day_ends = next_midnight(timestamp)
            self.flush()
        return self.state["days"].setdefault(self.day, blank_bucket())

    def hours(self, day, timestamp):
        """The hour slot for this event, kept sparse — only hours you moved in.

        Derived from the local minute and second rather than a modulo of the
        epoch, so the half-hour timezones land on their real hour boundaries.
        """
        if not (self.hour_starts <= timestamp < self.hour_ends):
            local = time.localtime(timestamp)
            self.hour = str(local.tm_hour)
            self.hour_starts = timestamp - (local.tm_min * 60 + local.tm_sec)
            self.hour_ends = self.hour_starts + 3600
        return day.setdefault("hours", {})

    def device_bucket(self, device):
        bucket = self.state["devices"].setdefault(device.name, blank_bucket())
        bucket["dpi"] = device.dpi
        bucket["dpiSource"] = device.source
        if device.dpi_x != device.dpi_y:
            bucket["dpiX"], bucket["dpiY"] = device.dpi_x, device.dpi_y
        else:
            bucket.pop("dpiX", None)
            bucket.pop("dpiY", None)
        return bucket

    def tally(self, seconds, device, field, amount):
        """Every count lands in all three ledgers: the day, all time, the device."""
        self.bucket(seconds)[field] += amount
        self.state["total"][field] += amount
        self.device_bucket(device)[field] += amount
        self.dirty = True

    # -- devices

    def rescan(self):
        live = {}
        for pointer in pointer_devices():
            name, path = pointer.name, pointer.path
            live[path] = name
            if path in self.devices:
                continue
            try:
                fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
            except OSError as error:
                if error.errno not in (errno.EACCES, errno.ENOENT):
                    print("mouse-odometer: %s: %s" % (path, error), file=sys.stderr)
                continue
            dpi, source = dpi_for(self.config, name, path, pointer.kind)
            self.devices[path] = Device(name, path, fd, dpi, source, pointer.kind, pointer.has_mt)
            device = self.devices[path]
            resolution = ("%g dpi" % device.dpi_x if device.dpi_x == device.dpi_y
                          else "%g x %g dpi" % (device.dpi_x, device.dpi_y))
            print("mouse-odometer: tracking %s (%s, %s, %s)"
                  % (name, path, resolution, DPI_SOURCE_LABEL.get(source, source)), file=sys.stderr)

        for path in [p for p in self.devices if p not in live]:
            self.drop(path)

    def drop(self, path):
        device = self.devices.pop(path, None)
        if not device:
            return
        try:
            os.close(device.fd)
        except OSError:
            pass
        print("mouse-odometer: dropped %s" % device.name, file=sys.stderr)

    # -- events

    def read(self, device):
        try:
            data = os.read(device.fd, EVENT.size * 256)
        except BlockingIOError:
            return True
        except OSError:
            return False
        if not data:
            return False

        for offset in range(0, len(data) - EVENT.size + 1, EVENT.size):
            seconds, _usec, kind, code, value = EVENT.unpack_from(data, offset)
            if kind == EV_REL:
                if code == REL_X:
                    device.dx += value
                elif code == REL_Y:
                    device.dy += value
                elif code in (REL_WHEEL, REL_HWHEEL):
                    # Only the coarse wheel axes; the HI_RES twins would
                    # double-count the same physical detent.
                    self.tally(seconds, device, "scrolls", abs(value))
            elif kind == EV_ABS and device.kind == "abs":
                self.absorb(device, code, value)
            elif kind == EV_KEY and code == BTN_TOUCH and device.kind == "abs":
                # Pads that predate multitouch report one finger through
                # ABS_X/ABS_Y, with BTN_TOUCH as the only word on whether it is
                # down. Standing in a tracking id keeps the lift-and-reland
                # guard below working the same on both generations.
                if not device.has_mt:
                    device.touches += 1
                    if value:
                        device.contacts[0] = [None, None, device.touches]
                    else:
                        device.contacts.pop(0, None)
            elif kind == EV_KEY and BTN_FIRST <= code <= BTN_LAST and value == 1:
                self.tally(seconds, device, "clicks", 1)
            elif kind == EV_SYN and code == SYN_REPORT:
                if device.kind == "abs":
                    self.settle(device, seconds)
                self.commit(device, seconds)
        return True

    def absorb(self, device, code, value):
        """Stash one absolute axis. Positions do not become movement until
        SYN_REPORT, when the whole report — every finger in it — is known."""
        if code == ABS_MT_SLOT:
            device.slot = value
        elif code == ABS_MT_TRACKING_ID:
            if value == -1:
                device.contacts.pop(device.slot, None)
            else:
                device.contacts.setdefault(device.slot, [None, None, value])[2] = value
        elif code == ABS_MT_POSITION_X:
            device.contacts.setdefault(device.slot, [None, None, 0])[0] = value
        elif code == ABS_MT_POSITION_Y:
            device.contacts.setdefault(device.slot, [None, None, 0])[1] = value
        elif not device.has_mt and code == ABS_X:
            device.contacts.setdefault(0, [None, None, 0])[0] = value
        elif not device.has_mt and code == ABS_Y:
            device.contacts.setdefault(0, [None, None, 0])[1] = value

    def settle(self, device, seconds):
        """Turn this report's finger positions into the delta a mouse would
        have sent, so that everything downstream can stay ignorant of the
        difference.

        Only the primary contact — the lowest live slot — contributes distance.
        A two-finger scroll is one hand moving, and adding both fingers up
        would claim the hand went twice as far as it did.
        """
        live = {slot: contact for slot, contact in device.contacts.items()
                if contact[0] is not None and contact[1] is not None}
        if not live:
            device.anchor = None
            device.scroll_units = 0
            return

        slot = min(live)
        x, y, track = live[slot]
        anchor, device.anchor = device.anchor, (slot, track, x, y)

        # A finger that has just landed has not travelled yet. Without this the
        # jump from wherever the last one lifted would be recorded as a swipe
        # across the whole pad, several times a minute.
        if not anchor or anchor[0] != slot or anchor[1] != track:
            return

        device.dx += x - anchor[2]
        device.dy += y - anchor[3]

        if len(live) == 2:
            device.scroll_units += abs(y - anchor[3])
            ticks, device.scroll_units = divmod(device.scroll_units, device.scroll_tick)
            if ticks:
                self.tally(seconds, device, "scrolls", ticks)

    def commit(self, device, seconds):
        """One SYN_REPORT of motion: add its straight-line hop to the path."""
        if not device.dx and not device.dy:
            return
        # Counts are kept raw for the record, but the conversion to distance
        # divides each axis by its own resolution before the hypotenuse — on a
        # mouse with asymmetric DPI, scaling the diagonal by one number is
        # wrong in proportion to how far it leans towards the odd axis.
        counts = math.hypot(device.dx, device.dy)
        meters = math.hypot(device.dx / device.dpi_x, device.dy / device.dpi_y) * INCH_M
        device.dx = device.dy = 0

        day = self.bucket(seconds)
        for bucket in (day, self.state["total"], self.device_bucket(device)):
            bucket["counts"] += counts
            bucket["meters"] += meters

        hours = self.hours(day, seconds)
        hours[self.hour] = hours.get(self.hour, 0.0) + meters
        # Hours in which the machine was used at all. It is the denominator
        # that makes progress measurable: metres per desk hour falls when you
        # reach for the keyboard instead, where metres per *mousing* hour just
        # measures how fast your hand sweeps and barely moves at all.
        day["desk_hours"] = len(hours)

        # "Active" time is wall-clock seconds in which the mouse moved at all,
        # which is what makes metres-per-hour mean anything.
        if seconds != self.last_active_second:
            self.last_active_second = seconds
            day["active_seconds"] += 1
            self.state["total"]["active_seconds"] += 1

        self.dirty = True

    # -- loop

    def flush(self):
        if not self.dirty:
            return
        save_state(self.state)
        self.dirty = False

    def run(self):
        stopping = []
        for sig in (signal.SIGINT, signal.SIGTERM):
            signal.signal(sig, lambda *_: stopping.append(True))

        self.rescan()
        save_state(self.state)
        next_scan = time.monotonic() + RESCAN_SECONDS
        next_flush = time.monotonic() + FLUSH_SECONDS

        while not stopping:
            fds = [device.fd for device in self.devices.values()]
            try:
                ready, _, _ = select.select(fds, [], [], 1.0)
            except InterruptedError:
                continue
            except OSError:
                ready = []

            for fd in ready:
                device = next((d for d in self.devices.values() if d.fd == fd), None)
                if device and not self.read(device):
                    self.drop(device.path)

            now = time.monotonic()
            if now >= next_scan:
                self.rescan()
                next_scan = now + RESCAN_SECONDS
            if now >= next_flush:
                self.flush()
                next_flush = now + FLUSH_SECONDS

        self.flush()
        save_state(self.state)
        return 0


# ------------------------------------------------------------------- report

def day_range(state, days, start=0):
    today = dt.date.today()
    return [state.get("days", {}).get((today - dt.timedelta(days=offset)).isoformat(), blank_bucket())
            for offset in range(start, start + days)]


def sparkline(values):
    peak = max(values) if values else 0
    if peak <= 0:
        return SPARK_BLOCKS[0] * len(values)
    steps = len(SPARK_BLOCKS) - 1
    return "".join(SPARK_BLOCKS[int(round(value / peak * steps))] for value in values)


def hourly_series(state, day_key, hours=24):
    """Today's metres, hour by hour, as a plain list of 24 numbers."""
    bucket = state.get("days", {}).get(day_key, {})
    stored = bucket.get("hours", {}) or {}
    return [float(stored.get(str(hour), 0) or 0) for hour in range(hours)]


def per_desk_hour(bucket):
    """Metres divided by hours in which the machine was used at all."""
    hours = float(bucket.get("desk_hours", 0) or 0)
    return (float(bucket.get("meters", 0) or 0) / hours) if hours > 0 else 0.0


def summed(buckets, key):
    return sum(float(bucket.get(key, 0) or 0) for bucket in buckets)


def cmd_status(args):
    config = load_config()
    units = "imperial" if args.imperial else ("metric" if args.metric else config.get("units", "metric"))
    state = load_state()

    if args.json:
        print(json.dumps(state, indent=2))
        return 0

    if not os.path.exists(STATE_PATH):
        print("No data yet. Start the tracker with:\n"
              "  systemctl --user enable --now omarchy-mouse-odometer.service")
        return 1

    today = state.get("days", {}).get(dt.date.today().isoformat(), blank_bucket())
    week = day_range(state, 7)
    month = day_range(state, 30)
    total = state.get("total", blank_bucket())
    # Yesterday back a week: a baseline today can be judged against.
    average = summed(day_range(state, 7, 1), "meters") / 7.0
    delta = ((float(today.get("meters", 0)) / average - 1) * 100) if average > 0 else 0.0

    print("Today       %10s   %s%.0f%% vs the previous 7 days"
          % (format_distance(today.get("meters", 0), units), "+" if delta >= 0 else "", delta))
    print("            %10s clicks, %s scroll ticks, %s of active mousing"
          % ("{:,}".format(int(today.get("clicks", 0))),
             "{:,}".format(int(today.get("scrolls", 0))),
             format_duration(today.get("active_seconds", 0))))
    print("Last 7 days %10s   (%s/day)"
          % (format_distance(summed(week, "meters"), units), format_distance(average, units)))
    print("Last 30 days%10s   (%s/day)"
          % (format_distance(summed(month, "meters"), units), format_distance(summed(month, "meters") / 30.0, units)))
    guessed = [name for name, bucket in (state.get("devices") or {}).items()
               if bucket.get("dpiSource") == "default"]
    if guessed:
        print("            %10s   distances assume %d dpi; trends are unaffected"
              % ("(estimated)", DEFAULT_DPI))
    print("Per desk hour%9s   the number worth shrinking"
          % format_distance(per_desk_hour(today), units))
    print("All time    %10s   since %s, %s clicks"
          % (format_distance(total.get("meters", 0), units), state.get("since", "?"),
             "{:,}".format(int(total.get("clicks", 0)))))

    print()
    print("14 days     %s  (now %s)"
          % (sparkline([float(bucket.get("meters", 0) or 0) for bucket in reversed(day_range(state, 14))]),
             format_distance(today.get("meters", 0), units)))
    print("Today       %s  hour by hour, 00-23"
          % sparkline(hourly_series(state, dt.date.today().isoformat())))

    if args.verbose:
        print()
        for name, bucket in sorted((state.get("devices") or {}).items(),
                                   key=lambda item: -float(item[1].get("meters", 0))):
            resolution = ("%g x %g dpi" % (bucket["dpiX"], bucket["dpiY"])
                          if bucket.get("dpiX") else "%g dpi" % bucket.get("dpi", DEFAULT_DPI))
            print("  %-34s %10s at %s"
                  % (name, format_distance(bucket.get("meters", 0), units), resolution))
    return 0


def cmd_devices(_args):
    config = load_config()
    devices = pointer_devices()
    if not devices:
        print("No pointer devices found.")
        return 1
    uncalibrated = False
    for pointer in devices:
        name, path = pointer.name, pointer.path
        (dpi_x, dpi_y), source = dpi_for(config, name, path, pointer.kind)
        resolution = "%g dpi" % dpi_x if dpi_x == dpi_y else "%g x %g dpi" % (dpi_x, dpi_y)
        readable = "" if os.access(path, os.R_OK) else "  [NOT READABLE — add yourself to the `input` group]"
        print("%-30s %-18s %-14s %s%s"
              % (name, path, resolution, DPI_SOURCE_LABEL.get(source, source), readable))
        uncalibrated = uncalibrated or source == "default"

    if uncalibrated:
        print()
        print("Nothing on this system knows that mouse's resolution, so distances")
        print("assume %d dpi. Trends and the progress score are unaffected — DPI is a" % DEFAULT_DPI)
        print("constant scale factor — but run `omarchy-mouse-odometer calibrate` if you")
        print("want the metres to be real.")
    return 0


def cmd_detect(_args):
    """Show what each source knows, so a wrong number can be traced."""
    config = load_config()
    for pointer in pointer_devices():
        name, path = pointer.name, pointer.path
        print("%s%s" % (name, "  (touchpad)" if pointer.kind == "abs" else ""))
        glass = abs_scale(path) if pointer.kind == "abs" else None
        if pointer.kind == "abs":
            print("  pad scale   %s" % (("%g x %g dpi, from the pad itself" % glass) if glass
                                        else "the pad does not report its resolution"))
        print("  udev hwdb   %s" % (("%g dpi" % hwdb_dpi(path)) if hwdb_dpi(path) else "nothing recorded"))
        live = ratbag_dpi(name)
        print("  hardware    %s" % (("%g dpi" % live) if live
                                    else "no libratbag support (install libratbag for gaming mice)"))
        pinned = configured_dpi(config, name)
        print("  calibrated  %s" % (("%g x %g dpi" % pinned) if pinned else "not measured yet"))
        (dpi_x, dpi_y), source = dpi_for(config, name, path, pointer.kind)
        print("  -> using    %g dpi (%s)" % (dpi_x, DPI_SOURCE_LABEL.get(source, source)))
    return 0


COMMON_DPI = (400, 500, 800, 1000, 1200, 1600, 2000, 2400, 3200)
AXES = {"x": ("horizontal", "to the right"), "y": ("vertical", "away from you, up the desk")}


def measure_drag(fd):
    """One drag: the net displacement on each axis, in counts.

    Net rather than path length on purpose — a ruler measures where the mouse
    ended up, so a wobble that goes out and comes back should cancel, exactly
    as it does on the desk.
    """
    dx = dy = 0
    while True:
        ready, _, _ = select.select([fd, sys.stdin], [], [])
        if sys.stdin in ready:
            sys.stdin.readline()
            return dx, dy
        try:
            data = os.read(fd, EVENT.size * 256)
        except BlockingIOError:
            continue
        for offset in range(0, len(data) - EVENT.size + 1, EVENT.size):
            _s, _u, kind, code, value = EVENT.unpack_from(data, offset)
            if kind == EV_REL and code == REL_X:
                dx += value
            elif kind == EV_REL and code == REL_Y:
                dy += value


def nearest_common(dpi):
    closest = min(COMMON_DPI, key=lambda candidate: abs(candidate - dpi))
    return closest if abs(closest - dpi) / dpi <= 0.04 else None


def calibrate_axis(fd, axis, distance_cm, passes):
    """Repeat the same drag and average it — one hand-drag carries real error."""
    name, direction = AXES[axis]
    inches = distance_cm / 2.54
    readings = []

    print("\n%s axis — %d passes of %.1f cm, dragging %s."
          % (name.capitalize(), passes, distance_cm, direction))
    attempt = 0
    while len(readings) < passes and attempt < passes * 3:
        attempt += 1
        input("  pass %d/%d — put the mouse on the start mark, then press Enter > "
              % (len(readings) + 1, passes))
        print("    measuring — drag %.1f cm %s now, then press Enter again."
              % (distance_cm, direction))
        dx, dy = measure_drag(fd)
        along, across = (dx, dy) if axis == "x" else (dy, dx)
        counts = abs(along)
        dpi = counts / inches if inches > 0 else 0

        # A pass is rejected on physics, not on taste: these bounds sit well
        # outside anything a real sensor reports, so only a mis-run trips them.
        if dpi < MIN_PLAUSIBLE_DPI:
            print("    only %d counts — that is about %.1f cm of travel, not %.1f."
                  % (counts, counts / 400.0 * 2.54, distance_cm))
            print("    Press Enter, then drag, then press Enter again. Retrying.")
            continue
        if dpi > MAX_PLAUSIBLE_DPI:
            print("    %d counts is more travel than %.1f cm can hold — did the drag "
                  "go further than the mark? Retrying." % (counts, distance_cm))
            continue

        drift = abs(across) / counts
        readings.append(dpi)
        print("    %d counts -> %.0f dpi%s"
              % (counts, dpi, "   (%.0f%% off-axis drift)" % (drift * 100) if drift > 0.15 else ""))

    if not readings:
        print("  No usable pass. Nothing was saved.")
        return None
    mean = statistics.mean(readings)
    spread = (max(readings) - min(readings)) / mean if len(readings) > 1 else 0
    print("  -> %.0f dpi (spread %.1f%%)" % (mean, spread * 100))
    if spread > 0.05:
        print("     Passes disagree by more than 5%; a longer drag gives a steadier number.")
    return mean


def cmd_calibrate(args):
    devices = pointer_devices()
    if args.device:
        devices = [d for d in devices
                   if args.device.lower() in d.name.lower() or args.device in d.path]
    if not devices:
        print("No matching pointer device.", file=sys.stderr)
        return 1

    # A ruler is for mice. Prefer one even when a pad is listed first, and say
    # so rather than walk someone through measuring a number the kernel knows.
    pointer = next((d for d in devices if d.kind == "rel"), devices[0])
    if pointer.kind == "abs":
        print("%s is a touchpad: it reports its own scale, so there is nothing"
              % pointer.name, file=sys.stderr)
        print("to calibrate. `omarchy-mouse-odometer detect` shows the figure it uses.",
              file=sys.stderr)
        return 1
    name, path = pointer.name, pointer.path

    axes = ["x", "y"] if args.axis == "both" else [args.axis]
    print("Calibrating: %s" % name)
    print("Put the mouse against a ruler and note where it starts. Each pass:")
    print("press Enter, drag %.1f cm in one smooth motion, press Enter again."
          % args.cm)

    try:
        fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
    except OSError as error:
        print("Cannot read %s: %s" % (path, error), file=sys.stderr)
        return 1

    results = {}
    try:
        for axis in axes:
            measured = calibrate_axis(fd, axis, args.cm, max(1, args.repeat))
            if measured is None:
                print("Nothing usable measured on the %s axis." % AXES[axis][0], file=sys.stderr)
                return 1
            results[axis] = measured
    finally:
        os.close(fd)

    if len(results) == 2:
        difference = abs(results["x"] - results["y"]) / statistics.mean(results.values())
        print("\nHorizontal %.0f dpi, vertical %.0f dpi — %.1f%% apart."
              % (results["x"], results["y"], difference * 100))
        if difference > AXIS_TOLERANCE:
            value = {"x": round(results["x"]), "y": round(results["y"])}
            print("Far enough apart to be a real difference; storing the axes separately.")
        else:
            averaged = statistics.mean(results.values())
            value = round(averaged)
            print("Within measurement error of each other, as one square sensor should be;")
            print("storing a single %d dpi." % value)
    else:
        axis = axes[0]
        value = round(results[axis])
        print("\n%.0f dpi on the %s axis." % (results[axis], AXES[axis][0]))

    if isinstance(value, int):
        suggestion = nearest_common(value)
        if suggestion and suggestion != value:
            print("That is within 4%% of %d, a standard setting — rounding to it."
                  % suggestion)
            value = suggestion

    shown = value if isinstance(value, int) else "x=%d y=%d" % (value["x"], value["y"])
    if not args.save:
        answer = input("Save %s for \"%s\"? [y/N] " % (shown, name)).strip().lower()
        if answer != "y":
            print("Not saved.")
            return 0

    config = load_config()
    config["devices"][name] = value
    save_config(config)
    print("Saved to %s" % CONFIG_PATH)
    cmd_restart(args)
    return 0


def cmd_set_dpi(args):
    config = load_config()
    key = "devices" if args.device else None
    if args.axis == "both":
        value = args.dpi
    else:
        existing = (config.get("devices", {}).get(args.device) if args.device
                    else config.get("dpi", DEFAULT_DPI))
        current_x, current_y = as_axes(existing, float(DEFAULT_DPI))
        value = {"x": args.dpi if args.axis == "x" else current_x,
                 "y": args.dpi if args.axis == "y" else current_y}
    if args.device:
        config["devices"][args.device] = value
    else:
        config["dpi"] = value
    save_config(config)
    print("Wrote %s" % CONFIG_PATH)
    print("Restart the tracker to pick it up: omarchy-mouse-odometer restart")
    return 0


def cmd_bootstrap(args):
    """Install and start the user service. Idempotent, and safe to call from
    the widget: a plugin installed with `omarchy plugin add` never gets to run
    an install script, so the bar has to be able to set itself up."""
    active = os.popen("systemctl --user is-active omarchy-mouse-odometer.service 2>/dev/null").read().strip()
    if active == "active" and not args.force:
        print("Tracker already running.")
        return 0

    plugin_dir = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
    unit_source = os.path.join(plugin_dir, "systemd", UNIT_NAME)
    if not os.path.exists(unit_source):
        print("Cannot find %s" % unit_source, file=sys.stderr)
        return 1

    unit_dir = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config"),
                            "systemd", "user")
    os.makedirs(unit_dir, exist_ok=True)
    unit_link = os.path.join(unit_dir, UNIT_NAME)
    if os.path.realpath(unit_link) != unit_source:
        if os.path.lexists(unit_link):
            os.unlink(unit_link)
        os.symlink(unit_source, unit_link)

    # A CLI on PATH is the difference between a tool and a background process.
    bin_dir = os.path.join(HOME, ".local", "bin")
    if os.path.isdir(bin_dir):
        link = os.path.join(bin_dir, "omarchy-mouse-odometer")
        target = os.path.realpath(__file__)
        if os.path.realpath(link) != target:
            if os.path.lexists(link):
                os.unlink(link)
            os.symlink(target, link)

    if not in_input_group():
        print("Warning: you are not in the 'input' group, so the tracker cannot read the mouse.",
              file=sys.stderr)
        print("  sudo usermod -aG input %s   (then log out and back in)"
              % os.environ.get("USER", "$USER"), file=sys.stderr)

    os.system("systemctl --user daemon-reload")
    status = os.system("systemctl --user enable --now " + UNIT_NAME) >> 8
    if status == 0 and not args.quiet:
        notify("Mouse Odometer is running",
               "Omarchy is built to be driven from the keyboard, so the point of "
               "this is to watch the number go down. Give it a week to learn your "
               "baseline. Distances are an estimate, not a measurement \u2014 run "
               "`omarchy-mouse-odometer calibrate` to make them yours.")
    return status


def notify(title, body):
    """Best-effort desktop notification; never fail the caller over it."""
    for command in ("omarchy-notification-send", "notify-send"):
        if os.system("command -v %s >/dev/null 2>&1" % command) == 0:
            os.system("%s %s %s >/dev/null 2>&1"
                      % (command, shell_quote(title), shell_quote(body)))
            return


def shell_quote(value):
    return "'" + str(value).replace("'", "'\\''") + "'"


def in_input_group():
    try:
        import grp
        return "input" in [grp.getgrgid(gid).gr_name for gid in os.getgroups()]
    except Exception:
        return True


def tracker_active():
    return os.popen("systemctl --user is-active %s 2>/dev/null" % UNIT_NAME).read().strip() == "active"


def rewriting_state(rewrite):
    """Rewrite the state file with the daemon stopped.

    The daemon holds the whole tally in memory and flushes every 15 seconds,
    so editing the file underneath it means the next flush silently reinstates
    the numbers you just corrected.
    """
    running = tracker_active()
    if running:
        os.system("systemctl --user stop " + UNIT_NAME)
    try:
        return rewrite()
    finally:
        if running:
            os.system("systemctl --user start " + UNIT_NAME)


def cmd_restart(_args):
    return os.system("systemctl --user restart omarchy-mouse-odometer.service") >> 8


def cmd_reset(args):
    if args.all and not args.yes:
        if input("Erase ALL mouse history? [y/N] ").strip().lower() != "y":
            return 1

    def rewrite():
        if args.all:
            fresh = {"version": STATE_VERSION, "since": dt.date.today().isoformat(),
                     "total": blank_bucket(), "days": {}, "devices": {}}
        else:
            fresh = load_state()
            fresh["days"].pop(dt.date.today().isoformat(), None)
        save_state(fresh)

    rewriting_state(rewrite)
    print("Reset, and the tracker restarted on the cleared history.")
    return 0


def cmd_rescale(args):
    """Re-scale recorded distance after a DPI correction.

    Distance is linear in DPI, so a wrong figure is a constant factor and the
    history can be repaired exactly rather than discarded.
    """
    state = load_state()
    config = load_config()

    target = args.to
    if target is None:
        pinned = configured_dpi(config, args.device or "")
        if not pinned:
            print("No calibrated DPI to scale to. Pass --to, or calibrate first.", file=sys.stderr)
            return 1
        target = pinned[0]

    factor = float(args.frm) / float(target)
    print("Recorded at %g dpi, correcting to %g dpi: every distance x %.4f"
          % (args.frm, target, factor))
    if not args.yes and input("Rewrite the stored history? [y/N] ").strip().lower() != "y":
        return 1

    def scale(bucket):
        bucket["meters"] = float(bucket.get("meters", 0) or 0) * factor
        if "hours" in bucket:
            bucket["hours"] = {hour: value * factor for hour, value in bucket["hours"].items()}

    def rewrite():
        fresh = load_state()
        scale(fresh["total"])
        for bucket in fresh.get("days", {}).values():
            scale(bucket)
        for bucket in fresh.get("devices", {}).values():
            scale(bucket)
        save_state(fresh)
        return 0

    rewriting_state(rewrite)
    print("Rewritten, and the tracker restarted on the corrected history.")
    return 0


def cmd_run(_args):
    return Tracker(load_config(), load_state()).run()


def main(argv):
    parser = argparse.ArgumentParser(prog="omarchy-mouse-odometer", description=__doc__.splitlines()[0])
    subs = parser.add_subparsers(dest="command")

    subs.add_parser("run", help="track pointer movement (the systemd service)").set_defaults(func=cmd_run)

    status = subs.add_parser("status", help="today / week / all-time summary")
    status.add_argument("--json", action="store_true", help="dump the raw state file")
    status.add_argument("--verbose", "-v", action="store_true", help="per-device breakdown")
    status.add_argument("--metric", action="store_true")
    status.add_argument("--imperial", action="store_true")
    status.set_defaults(func=cmd_status)

    subs.add_parser("devices", help="list pointer devices being watched").set_defaults(func=cmd_devices)
    subs.add_parser("detect", help="show where each mouse's DPI figure comes from").set_defaults(func=cmd_detect)

    calibrate = subs.add_parser("calibrate", help="measure the real DPI of a mouse")
    calibrate.add_argument("--cm", type=float, default=20.0, help="distance you will drag (default 20)")
    calibrate.add_argument("--repeat", type=int, default=3, help="passes per axis to average (default 3)")
    calibrate.add_argument("--axis", choices=["x", "y", "both"], default="both",
                           help="which axis to measure (default both)")
    calibrate.add_argument("--device", help="device name substring")
    calibrate.add_argument("--save", action="store_true", help="save without asking")
    calibrate.set_defaults(func=cmd_calibrate)

    setdpi = subs.add_parser("set-dpi", help="record a known DPI")
    setdpi.add_argument("dpi", type=float)
    setdpi.add_argument("--device", help="device name substring (default: all mice)")
    setdpi.add_argument("--axis", choices=["x", "y", "both"], default="both",
                        help="set one axis only (default both)")
    setdpi.set_defaults(func=cmd_set_dpi)

    bootstrap = subs.add_parser("bootstrap", help="install and start the tracker service")
    bootstrap.add_argument("--force", action="store_true", help="re-link even when already running")
    bootstrap.add_argument("--quiet", action="store_true", help="skip the desktop notification")
    bootstrap.set_defaults(func=cmd_bootstrap)

    rescale = subs.add_parser("rescale", help="fix recorded distance after a DPI correction")
    rescale.add_argument("--from", dest="frm", type=float, required=True,
                         help="the DPI the history was recorded at")
    rescale.add_argument("--to", type=float, help="the correct DPI (default: your calibrated value)")
    rescale.add_argument("--device", help="device name substring for the calibrated lookup")
    rescale.add_argument("--yes", "-y", action="store_true")
    rescale.set_defaults(func=cmd_rescale)

    subs.add_parser("restart", help="restart the tracker service").set_defaults(func=cmd_restart)

    reset = subs.add_parser("reset", help="clear today's tally, or everything")
    reset.add_argument("--all", action="store_true")
    reset.add_argument("--today", action="store_true")
    reset.add_argument("--yes", "-y", action="store_true")
    reset.set_defaults(func=cmd_reset)

    args = parser.parse_args(argv)
    if not getattr(args, "func", None):
        args = parser.parse_args(["status"])
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
